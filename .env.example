# RAUNDO Telegram Bot configuration. Copy to .env LOCALLY. Never commit actual tokens.
BOT_TOKEN=
BOT_MODE=polling
ENVIRONMENT=development
# Telegram numeric IDs of reviewed RAUNDO admins, CSV. Never auto-authorize by username.
ADMIN_TELEGRAM_IDS=
# Isolated local database only; never point this copy at a live service.
DATABASE_URL=postgresql+asyncpg://raundo:raundo_local_only@127.0.0.1:55432/raundo_admin_dev
REDIS_URL=redis://127.0.0.1:56379/0
LOG_LEVEL=INFO
POLICY_VERSION=2026-10-22-draft
RATE_LIMIT_PER_WINDOW=30
RATE_LIMIT_WINDOW_SECONDS=10
# Opt-in only. Do not enable in production — may log row field values.
SQL_ECHO=false
# For configured HTTPS webhook mode only:
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=
# Set before first real 14-day cycle; example is NOT a published start date.
RANKING_EPOCH_UTC=
SUPPORT_MAX_OPEN_TICKETS=3
MAX_PHOTOS_PER_STARTUP=3
# Stars plans and prices must be configured after legal/commercial review; do not guess.

# ---------------------------------------------------------------------------
# Premium payments (never commit real keys). Default is demo: no charges.
# demo | provider_test | live
PAYMENTS_MODE=demo
PAYMENTS_CARD_ENABLED=true
PAYMENTS_STARS_ENABLED=false
# Live money is blocked until the owner sets these after legal/commercial review.
PAYMENTS_PRICES_APPROVED=false
PAYMENTS_LEGAL_READY=false
PAYMENTS_STARS_PRICES_APPROVED=false
# Public HTTPS origin of the checkout (local default works for the local bot).
CHECKOUT_BASE_URL=http://127.0.0.1:8090
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
# Seller details are required before live sales; leave empty in demo.
PAYMENT_SELLER_NAME=
PAYMENT_SELLER_INN=
PAYMENT_SELLER_CONTACT=
PAYMENT_CONSENT_VERSION=payments-2026-11-03-draft
